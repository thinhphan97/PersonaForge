ARG CUDA_IMAGE=nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04
FROM ${CUDA_IMAGE}

ARG PYTORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu128
ARG WORKER_UID=1000
ARG WORKER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PROJECT_ROOT=/app \
    PATH=/opt/personaforge-venv/bin:$PATH

WORKDIR /app

# Ubuntu 24.04 provides Python 3.12. CUDA/cuDNN come from the NVIDIA base image;
# the host still supplies the compatible kernel driver through Container Toolkit.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        git \
        gosu \
        python3 \
        python3-pip \
        python3-venv \
    && python3 -m venv /opt/personaforge-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.worker.txt ./requirements.worker.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.worker.txt \
    && pip uninstall -y onnxruntime \
    && pip install --no-cache-dir "onnxruntime-gpu>=1.20,<2" \
    && pip install --no-cache-dir \
        --index-url ${PYTORCH_CUDA_INDEX} \
        "torch==2.8.0" \
        "torchaudio==2.8.0" \
    && pip install --no-cache-dir \
        "transformers==5.14.1" \
    && pip install --no-cache-dir --no-deps \
        "vieneu @ git+https://github.com/pnnbao97/VieNeu-TTS.git@a8c9fbf99749d5ce45c89111f71558d6ceef3424"

COPY src/personaforge_chat ./src/personaforge_chat
COPY src/personaforge_worker ./src/personaforge_worker
COPY src/personaforge ./src/personaforge
COPY src/personaforge_observability ./src/personaforge_observability
COPY third_party/LAM_Audio2Expression ./third_party/LAM_Audio2Expression
COPY scripts/generate_demo_videos.sh ./scripts/generate_demo_videos.sh
COPY scripts/worker-entrypoint.sh ./scripts/worker-entrypoint.sh
RUN bash scripts/generate_demo_videos.sh \
    && chmod 0755 scripts/worker-entrypoint.sh \
    && groupadd --gid ${WORKER_GID} personaforge \
    && useradd --create-home --uid ${WORKER_UID} --gid ${WORKER_GID} personaforge \
    && mkdir -p /var/lib/personaforge/avatar-worker /run/personaforge/worker-master \
    && chown -R personaforge:personaforge \
        /app /opt/personaforge-venv /var/lib/personaforge /run/personaforge

ENTRYPOINT ["/app/scripts/worker-entrypoint.sh"]
CMD ["python", "-m", "personaforge_worker.main"]
