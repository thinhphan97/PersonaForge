APP_HOST=0.0.0.0
APP_PORT=8000
# Root containing frontend/assets when installed as a wheel. Docker sets /app automatically.
# PROJECT_ROOT=/absolute/path/to/webrtc-dev
# Docker host port. Change it when port 8000 is occupied.
APP_HTTP_PORT=8000

# aiortc (default, single process) | livekit (Redis + Render Worker + SFU)
MEDIA_PROVIDER=aiortc

# Local LiveKit development values. Change every credential in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_WORKER_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Change these host ports when they are already occupied.
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
# Set this to the server's LAN/public IP when the browser runs on another host.
LIVEKIT_NODE_IP=
REDIS_URL=redis://redis:6379/0
# auto = Redis in livekit mode, memory in aiortc mode.
REALTIME_EVENT_BUS=auto
RENDER_WORKER_ID=avatar-worker-1

# Render Worker media cadence.
WORKER_VIDEO_WIDTH=640
WORKER_VIDEO_HEIGHT=360
WORKER_VIDEO_FPS=25
WORKER_VIDEO_BITRATE=1500000
WORKER_AUDIO_SAMPLE_RATE=48000
WORKER_AUDIO_FRAME_DURATION=0.02
WORKER_VIDEO_QUEUE_MS=80

# Docker Compose PostgreSQL. Change credentials in non-local environments.
POSTGRES_DB=avatar
POSTGRES_USER=avatar
POSTGRES_PASSWORD=avatar
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://avatar:avatar@postgres:5432/avatar
# Compose runs Alembic before Uvicorn; do not let create_all manage persistent schema.
AUTO_CREATE_SCHEMA=false

# Browser authentication. Production requires HTTPS and AUTH_COOKIE_SECURE=true.
REFRESH_COOKIE_NAME=avatar_refresh
AUTH_COOKIE_SECURE=false
JWT_SECRET=development-only-jwt-secret-change-me-32-bytes
JWT_ISSUER=avatar-chat
JWT_AUDIENCE=avatar-chat-browser
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:18000

# scripted | http
REPLY_PROVIDER=scripted
# Minimum delay between text chunks, keeping the avatar in speaking state longer.
REPLY_CHUNK_DELAY=0.25

# Keep the thinking clip visible before switching to speaking.
THINKING_MIN_DURATION=1.0

# Every interval: 100 ms beep + simultaneous white video flash.
AV_SYNC_DEBUG=true
AV_SYNC_INTERVAL=2.0
AV_SYNC_PULSE_DURATION=0.1

# Generic streaming model adapter. Each SSE/NDJSON event must be: {"text":"..."}
# REPLY_HTTP_URL=http://model-service:9000/replies/stream
# REPLY_HTTP_TOKEN=

# Agent execution boundary. "local" keeps the legacy in-process demo; "grpc"
# delegates each turn to the standalone PersonaForge Agent Runtime.
AGENT_RUNTIME_PROVIDER=local
AGENT_GRPC_TARGET=personaforge-agent:50051
# Optional TLS/mTLS file paths mounted into Core and Agent containers.
AGENT_GRPC_CA_FILE=
AGENT_GRPC_CLIENT_CERT_FILE=
AGENT_GRPC_CLIENT_KEY_FILE=
AGENT_GRPC_TLS_CERT_FILE=
AGENT_GRPC_TLS_KEY_FILE=
AGENT_GRPC_TLS_CLIENT_CA_FILE=
AGENT_TURN_TIMEOUT=120
AGENT_IDLE_TIMEOUT=15
AGENT_MODEL_PROVIDER=scripted
AGENT_CHUNK_DELAY=0.1
AGENT_HEARTBEAT_INTERVAL=5
AGENT_MAX_CONCURRENT_TURNS=20
AGENT_MAX_QUEUED_TURNS=100
AGENT_MAX_CONCURRENT_PER_USER=3
AGENT_MAX_CONCURRENT_PER_SESSION=1
AGENT_QUEUE_TIMEOUT=10
# Redis distributed turn registry rejects duplicate turn IDs across Agent replicas.
AGENT_TURN_REGISTRY_PROVIDER=redis
AGENT_TURN_CLAIM_LEASE=60
AGENT_TURN_RESULT_RETENTION=86400
AGENT_GRACEFUL_SHUTDOWN_TIMEOUT=30
AGENT_MAX_MESSAGE_CHARS=20000
AGENT_MAX_HISTORY_MESSAGES=50
AGENT_MAX_HISTORY_CHARS=100000
AGENT_MAX_SCOPES=100
# Protect GetRuntimeStatus in production; health RPC remains available internally.
AGENT_STATUS_TOKEN=
# Redis session lease wait. Zero rejects a concurrent session turn immediately.
SESSION_TURN_LOCK_PROVIDER=redis
SESSION_TURN_LOCK_TIMEOUT=0
SESSION_TURN_LOCK_LEASE=30
# Core API and Agent Runtime must use exactly the same delegation settings.
AGENT_DELEGATION_SECRET=development-agent-delegation-secret-change-me
AGENT_DELEGATION_ISSUER=personaforge-api
AGENT_DELEGATION_AUDIENCE=personaforge-agent

# Comma-separated STUN/TURN URLs. Keep empty for localhost-only development.
WEBRTC_ICE_SERVERS=
# WEBRTC_ICE_USERNAME=
# WEBRTC_ICE_CREDENTIAL=

# Character catalog root. Each child directory needs idle/thinking/speaking.mp4.
# AVATAR_CHARACTERS_ROOT=/data/characters
# Optional overrides for the default character clips.
# AVATAR_IDLE_VIDEO=/data/avatar/idle.mp4
# AVATAR_THINKING_VIDEO=/data/avatar/thinking.mp4
# AVATAR_SPEAKING_VIDEO=/data/avatar/speaking.mp4
